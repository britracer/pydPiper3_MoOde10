[Unit]
Description = pydPiper
Requires = docker.service
After = mpd.service docker.service

[Service]
Restart = always
ExecStart = /usr/bin/docker run --network=host --privileged -v /var/log:/var/log:rw -v /home/pi/pydPiper3:/app:rw synoniem/pydpiper3 python /app/pydPiper.py
ExecStop = /usr/bin/docker stop -t 2 synoniem/pydpiper3:latest

[Install]
WantedBy = multi-user.target

